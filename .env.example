# ==============================================================================
# Ekriti NEET Preparation Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate with your environment values.
# NEVER commit .env or .env.local containing real production credentials.

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Ekriti NEET UG 2027 CBT & Intelligence Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# Default local development uses SQLite:
DATABASE_URL="file:./dev.db"

# For Production (PostgreSQL / Supabase / Neon / RDS):
# DATABASE_URL="postgresql://user:password@host:5432/ekriti_neet?schema=public&sslmode=prefer"
# DIRECT_URL="postgresql://user:password@host:5432/ekriti_neet?schema=public"

# ------------------------------------------------------------------------------
# 3. SECURITY & SIGNING
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and media URLs
STORAGE_SIGNING_SECRET="change-this-to-a-secure-random-secret-in-production"

# ------------------------------------------------------------------------------
# 4. OPTIONAL AI & LLM PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
# Grounded deterministic engines do not require external LLM keys.
# Configure these if external AI coach/remediation enhancement is enabled:
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & WORKERS (Optional)
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
WORKER_CONCURRENCY="2"
