model OfficialSource {
  id                  String               @id @default(cuid())
  name                String               // e.g. "NTA Main Portal", "NTA NEET Portal", "NMC / UGMEB"
  code                String               @unique // "NTA" | "NEET_PORTAL" | "NMC"
  authority           String               // "NTA" | "NMC_UGMEB"
  websiteUrl          String
  noticeBoardUrl      String
  tier                String               @default("TIER_1") // TIER_1
  status              String               @default("HEALTHY") // HEALTHY | DEGRADED | OUTAGE
  lastCheckedAt       DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastFailureReason   String?
  contentHash         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
