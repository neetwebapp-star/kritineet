  selectedByCorrectResponders     Int       @default(0)
  selectedByIncorrectResponders   Int       @default(0)
  distractorCategory              String    @default("NORMAL") // STRONG | WEAK | SUSPICIOUS | AMBIGUOUS | KEY | NORMAL
