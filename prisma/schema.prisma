  question                   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptCount               Int       @default(0)
  uniqueStudentCount         Int       @default(0)
  correctCount               Int       @default(0)
  incorrectCount             Int       @default(0)
  skippedCount               Int       @default(0)
  accuracyRate               Float     @default(0.0) // 0.0 - 100.0
  skipRate                   Float     @default(0.0) // 0.0 - 100.0
  authoredDifficulty         String    @default("MEDIUM") // EASY | MEDIUM | HARD
  estimatedDifficulty        String    @default("MEDIUM")
  observedDifficulty         String    @default("MEDIUM")
  difficultyConfidence       String    @default("INSUFFICIENT") // INSUFFICIENT | LOW | MEDIUM | HIGH
  discriminationIndex        Float     @default(0.0) // -1.0 to 1.0
  discriminationConfidence   String    @default("INSUFFICIENT") // INSUFFICIENT | LOW | MEDIUM | HIGH
  averageResponseTime        Float     @default(0.0) // in seconds
  medianResponseTime         Float     @default(0.0) // in seconds
  timeP25                    Float     @default(0.0)
  timeP50                    Float     @default(0.0)
  timeP75                    Float     @default(0.0)
  timeP90                    Float     @default(0.0)
  optionDistribution         String?   // JSON map: { "A": 12, "B": 85, "C": 5, "D": 2 }
  distractorEffectiveness    String?   // JSON map: { "A": "WEAK", "B": "KEY", "C": "SUSPICIOUS", "D": "STRONG" }
  conceptPerformance         String?   // JSON map
  ambiguityScore             Float     @default(0.0) // 0.0 to 1.0
  qualityScore               Float     @default(1.0) // 0.0 to 1.0
  assessmentStatus           String    @default("ACTIVE") // ACTIVE | MONITORED | REVIEW_REQUIRED | TEMPORARILY_SUPPRESSED | RETIRED
  lastCalculatedAt           DateTime  @default(now())
  calculationVersion         String    @default("v1.0")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([assessmentStatus])
  @@index([observedDifficulty])
  @@index([qualityScore])
  @@index([difficultyConfidence])
  @@index([discriminationConfidence])
}

model QuestionPerformanceSnapshot {
