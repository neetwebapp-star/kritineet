  examEdition              ExamEdition?                    @relation(fields: [examEditionId], references: [id])
  noticeNumber             String?                         // e.g. "NTA/NEET/2026/01"
  title                    String
  authority                String                          // "NTA" | "NMC" | "UGMEB"
  category                 String                          // EXAM_DATE | EXAM_MODE | APPLICATION | SYLLABUS | etc.
  alertLevel               String                          @default("INFO") // INFO | IMPORTANT | ACTION_REQUIRED | CRITICAL
  status                   String                          @default("PUBLISHED") // DETECTED | FETCHED | VERIFIED | CLASSIFIED | PUBLISHED | SUPERSEDED | CORRECTED | ARCHIVED | REJECTED
  isNeetRelevant           Boolean                         @default(true)
  examYear                 Int?                            // 2026, 2027 or null if UNKNOWN
  isHistorical             Boolean                         @default(false) // True for historical reference
  publishedAt              DateTime
  effectiveDate            DateTime?
  detectedAt               DateTime                        @default(now())
  lastVerifiedAt           DateTime                        @default(now())
  officialSourceUrl        String
  officialDocumentUrl      String?
  documentHash             String?
  officialFactExtractJson  String?                         // JSON structured facts
  aiSummary                String?                         // Grounded AI summary strictly with citation
  aiSummaryEvidence        String?                         // Grounded page/section citation
  studentActionRequired    String?                         // Only if explicitly mandated
  affectedSectionsJson     String?                         // JSON
  relatedNoticeId          String?                         // For Corrigendums / Superseded notices
  versions                 OfficialNotificationVersion[]
  readStates               OfficialNotificationReadState[]
  impacts                  NotificationImpact[]
  auditLogs                NotificationAuditLog[]
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  @@index([sourceId])
  @@index([status])
  @@index([category])
  @@index([examYear])
  @@index([isHistorical])
  @@index([publishedAt])
}

model OfficialNotificationVersion {
