  sessions              StudySession[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([userId, date, planVersion])
  @@index([userId, date])
  @@index([status])
}

model DailyStudyTask {
  id               String          @id @default(cuid())
  planId           String
  plan             DailyStudyPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String          // YYYY-MM-DD
  taskType         String          // NCERT_READ | NCERT_REVISION | CONCEPT_LEARNING | PRACTICE | PYQ | FINGERTIPS | MISTAKE_REVIEW | SPACED_REVISION | MOCK_TEST | TEST_REVIEW | AI_TUTOR | FORMULA_REVISION | DIAGRAM_REVISION | REMEDIATION_TASK
  title            String
  description      String?
  subjectCode      String          // PHYSICS | CHEMISTRY | BIOLOGY
  chapterSlug      String?
  chapterTitle     String?
  topicId          String?
  conceptId        String?
  sourceType       String          @default("NCERT") // NCERT | PYQ | FINGERTIPS | MISTAKE | MOCK | GENERAL
  estimatedMinutes Int             @default(30)
  actualMinutes    Int             @default(0)
  priority         String          @default("CORE") // CORE | RECOMMENDED | OPTIONAL
  priorityScore    Float           @default(50.0)
  priorityReasons  String?         // JSON array: ["REVISION_DUE", "LOW_MASTERY"]
  orderIndex       Int             @default(1)
  status           String          @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED | MISSED | DEFERRED | CARRIED_FORWARD
  routeUrl         String?         // Direct routing experience URL e.g. "/practice?conceptId=..."
  metaJson         String?         // JSON payload: questionIds, testId, etc.
  isMentorAssigned Boolean         @default(false)
  mentorId         String?
  mentorNote       String?
  completedAt      DateTime?
  sessions         StudySession[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([planId])
  @@index([userId, date])
  @@index([status])
  @@index([taskType])
  @@index([priority])
}

model StudySession {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String?
  plan                  DailyStudyPlan? @relation(fields: [planId], references: [id])
  taskId                String?
  task                  DailyStudyTask? @relation(fields: [taskId], references: [id])
  status                String          @default("PLANNED") // PLANNED | STARTED | PAUSED | RESUMED | COMPLETED | ABANDONED | EXPIRED
  startTime             DateTime?
  endTime               DateTime?
  activeDurationSeconds Int             @default(0)
  pausedDurationSeconds Int             @default(0)
  plannedMinutes        Int             @default(30)
  actualMinutes         Int             @default(0)
  timerPreset           String?         // CUSTOM | 25_5 | 45_10 | 50_10 | 60_10
  currentPositionJson   String?         // JSON: { questionIndex: 4, pageNumber: 12, scrollOffset: 340 }
  events                StudyEvent[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([userId])
  @@index([taskId])
  @@index([planId])
  @@index([status])
}

model StudyEvent {
