// ============================================================================
// PHASE 9: EXAM INTELLIGENCE & PREPARATION OPERATING SYSTEM MODELS
// ============================================================================

model Exam {
  id             String        @id @default(cuid())
  code           String        @unique // e.g. "NEET_UG"
  name           String        // "National Eligibility cum Entrance Test (Undergraduate)"
  shortName      String        @default("NEET UG")
  conductingBody String        @default("NTA") // National Testing Agency
  description    String?
  editions       ExamEdition[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([code])
}

model ExamEdition {
  id               String               @id @default(cuid())
  examId           String
  exam             Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  editionYear      Int                  // 2027
  title            String               // "NEET UG 2027"
  officialExamDate DateTime?            // null when NOT_YET_PUBLISHED
  status           String               @default("NOT_YET_PUBLISHED") // NOT_YET_PUBLISHED | ANNOUNCED | CONFIRMED | COMPLETED | ARCHIVED
  isActive         Boolean              @default(true)
  syllabusVersion  Int                  @default(1)
  patternVersion   Int                  @default(1)
  updates          ExamUpdate[]
  rules            ExamRule[]
  syllabi          ExamSyllabus[]
  patternVersions  ExamPatternVersion[]
  preparationPlans PreparationPlan[]
  checklistItems   ExamDayChecklist[]
  officialNotifications OfficialNotification[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([examId, editionYear])
  @@index([isActive])
  @@index([status])
}

model ExamOfficialSource {
  id                  String    @id @default(cuid())
  sourceName          String    // e.g. "NTA Official Portal", "NMC Guidelines"
  sourceUrl           String
  sourceTier          String    @default("OFFICIAL_SOURCE") // OFFICIAL_SOURCE | VERIFIED_PLATFORM_DATA | SECONDARY_REFERENCE | UNVERIFIED
  authorityType       String    @default("GOVERNMENT_BODY") // GOVERNMENT_BODY | STATUTORY_COUNCIL | TESTING_AGENCY
  contentHash         String?
  lastCheckedAt       DateTime  @default(now())
  lastSuccessfulCheck DateTime?
  status              String    @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([sourceTier])
}

model ExamUpdate {
  id                   String                   @id @default(cuid())
  editionId            String
  edition              ExamEdition              @relation(fields: [editionId], references: [id], onDelete: Cascade)
  title                String
  publicationDate      DateTime                 @default(now())
  effectiveDate        DateTime?
  sourceName           String
  sourceUrl            String
  sourceHierarchy      String                   @default("OFFICIAL_SOURCE") // OFFICIAL_SOURCE | VERIFIED_PLATFORM_DATA | SECONDARY_REFERENCE | UNVERIFIED
  updateType           String                   // SYLLABUS_CHANGE | DATE_ANNOUNCEMENT | PATTERN_CHANGE | ELIGIBILITY_CHANGE | REGISTRATION | GENERAL_NOTIFICATION
  impactLevel          String                   @default("MEDIUM") // HIGH | MEDIUM | LOW | INFORMATIONAL
  impactSummary        String?
  previousValue        String?                  // JSON or text
  newValue             String?                  // JSON or text
  verificationStatus   String                   @default("UNVERIFIED") // UNVERIFIED | VERIFIED | SUPERSEDED | ARCHIVED
  verifiedAt           DateTime?
  verifiedBy           String?
  affectedEntitiesJson String?                  // JSON: { chapters: [...], questions: [...], tests: [...] }
  notifications        ExamUpdateNotification[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([editionId])
  @@index([verificationStatus])
  @@index([updateType])
}

model ExamRule {
  id                 String      @id @default(cuid())
  editionId          String
  edition            ExamEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  ruleKey            String      // e.g. "MARKING_SCHEME", "ELIGIBILITY_AGE", "QUESTION_COUNT"
  ruleCategory       String      // ELIGIBILITY | EXAMINATION | SCORING | ADMISSION
  ruleTitle          String
  ruleValue          String      // e.g. "+4 for correct, -1 for incorrect, 0 for unattempted"
  sourceName         String
  sourceUrl          String
  verificationStatus String      @default("VERIFIED") // UNVERIFIED | VERIFIED | SUPERSEDED | ARCHIVED
  publishedAt        DateTime    @default(now())
  verifiedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([editionId])
  @@index([ruleKey])
}

model ExamSyllabus {
  id                String             @id @default(cuid())
  editionId         String
  edition           ExamEdition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  version           Int                @default(1)
  title             String             // "NEET UG 2027 Syllabus v1"
  source            String             // "NMC Curriculum Guidelines"
  effectiveDate     DateTime           @default(now())
  publishedDate     DateTime           @default(now())
  status            String             @default("ACTIVE") // ACTIVE | SUPERSEDED | DRAFT | ARCHIVED
  syllabusDataJson  String             // JSON tree with included chapters/topics/concepts
  summaryOfChanges  String?
  diffsFrom         ExamSyllabusDiff[] @relation("FromSyllabus")
  diffsTo           ExamSyllabusDiff[] @relation("ToSyllabus")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([editionId, version])
  @@index([status])
}

model ExamSyllabusDiff {
  id                     String       @id @default(cuid())
  fromSyllabusId         String
  fromSyllabus           ExamSyllabus @relation("FromSyllabus", fields: [fromSyllabusId], references: [id], onDelete: Cascade)
  toSyllabusId           String
  toSyllabus             ExamSyllabus @relation("ToSyllabus", fields: [toSyllabusId], references: [id], onDelete: Cascade)
  diffSummary            String
  diffDetailsJson        String       // JSON: { added: [...], removed: [...], modified: [...], renamed: [...], unchanged: [...] }
  affectedQuestionsCount Int          @default(0)
  affectedConceptsCount  Int          @default(0)
  createdAt              DateTime     @default(now())

  @@index([fromSyllabusId])
  @@index([toSyllabusId])
}

model ExamPatternVersion {
  id                  String      @id @default(cuid())
  editionId           String
  edition             ExamEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  versionNumber       Int         @default(1)
  durationMinutes     Int         @default(200)
  totalQuestions      Int         @default(200)
  totalMarks          Float       @default(720.0)
  positiveMarks       Float       @default(4.0)
  negativeMarks       Float       @default(1.0)
  subjectConfigJson   String      // JSON: { BIOLOGY: 100, PHYSICS: 50, CHEMISTRY: 50 }
  sectionConfigJson   String?     // JSON: { SectionA: { count: 35, compulsory: true }, SectionB: { count: 15, maxToAttempt: 10 } }
  instructions        String?
  status              String      @default("ACTIVE") // ACTIVE | SUPERSEDED | DRAFT
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  simulationBlueprints ExamSimulationBlueprint[]
  examSimulations      ExamSimulation[]

  @@unique([editionId, versionNumber])
  @@index([status])
}

model StudentPlanningConfig {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetExamEditionId   String?
  studentPlanningDate   DateTime? // Student's personal target date (distinct from official date)
  weekdayDailyHours     Float     @default(3.0)
  weekendDailyHours     Float     @default(6.0)
  preferredWindowsJson  String?   // JSON: ["MORNING", "EVENING"]
  targetIntensity       String    @default("BALANCED") // RELAXED | BALANCED | INTENSIVE | CRASH
  restDaysJson          String?   // JSON: ["SUNDAY_EVENING"]
  currentStage          String    @default("FOUNDATION") // FOUNDATION | SYLLABUS_COMPLETION | FIRST_REVISION | PYQ_PHASE | MOCK_PHASE | FINAL_REVISION | EXAM_READY
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model PreparationPlan {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  editionId             String?
  edition               ExamEdition?         @relation(fields: [editionId], references: [id])
  version               Int                  @default(1) // Plan v1, Plan v2, ...
  status                String               @default("ACTIVE") // ACTIVE | SUPERSEDED | ARCHIVED
  targetExamDate        DateTime?
  currentStage          String               @default("FOUNDATION")
  weeklyCapacityHours   Float                @default(27.0)
  plannedWorkloadHours  Float                @default(25.0)
