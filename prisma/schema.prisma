generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  role         String          @default("STUDENT") // STUDENT | ADMIN
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      StudentProfile?
  attempts     ExamAttempt[]
  mistakes     StudentMistake[]
  bookmarks        StudentBookmark[]
  revisions        RevisionSchedule[]
  progress         StudyProgress[]
  auditLogs        AuditLog[]
  conceptMasteries StudentConceptMastery[]
  attemptEvents    AttemptEvent[]
  exposures        QuestionExposure[]
  dailyPlans       DailyLearningPlan[]
  snapshots        PerformanceSnapshot[]
  tutorConversations TutorConversation[]
  aiFeedback         AIFeedback[]
  aiUsageLogs        AIUsageLog[]
  aiRateLimit        AIRateLimit?

  // Phase 7: Command Center Relations
  parentRelationshipsAsParent  ParentStudentRelationship[] @relation("ParentRelationship")
  parentRelationshipsAsStudent ParentStudentRelationship[] @relation("StudentParentRelationship")
  mentorAssignmentsAsMentor    MentorStudentAssignment[]   @relation("MentorAssignments")
  mentorAssignmentsAsStudent   MentorStudentAssignment[]   @relation("StudentMentorAssignments")
  assignmentsCreated           Assignment[]                @relation("AssignmentCreator")
  assignmentsAssigned          AssignmentProgress[]        @relation("StudentAssignments")
  mentorNotesAuthored          MentorNote[]                @relation("NoteAuthor")
  mentorNotesReceived          MentorNote[]                @relation("StudentNotes")
  notifications                Notification[]              @relation("UserNotifications")
  goals                        Goal[]                      @relation("UserGoals")
  activities                   LearningActivity[]          @relation("UserActivities")
  alerts                       Alert[]                     @relation("UserAlerts")
  invitationsCreated           Invitation[]                @relation("InvitationCreator")

  // Phase 8: Multi-Tenant & SaaS Relations
  tenantId                     String?
  tenant                       Tenant?                     @relation("TenantUsers", fields: [tenantId], references: [id])
  diagnostics                  StudentDiagnostic[]

  // Phase 9: Exam Intelligence & Preparation OS
  planningConfig               StudentPlanningConfig?
  preparationPlans             PreparationPlan[]
  examUpdateNotifications      ExamUpdateNotification[]

  // Phase 16: NTA Notifications & Official Intelligence Center
  officialNotificationReads    OfficialNotificationReadState[]
  notificationSubscription     NotificationSubscription?

  // Phase 10: Advanced Assessment, Question Intelligence & Psychometrics 2.0
  assessmentBaseline           StudentAssessmentBaseline?
  questionReviewsAuthored      QuestionReview[]

  // Phase 11: NEET Personal AI Study Operating System
  preparationProfile           StudentPreparationProfile?
  dailyStudyPlans              DailyStudyPlan[]
  dailyStudyTasks              DailyStudyTask[]
  studySessions                StudySession[]
  studyEvents                  StudyEvent[]
  preparationBacklogItems      PreparationBacklog[]
  planVersions                 PlanVersion[]
  recoveryPlans                RecoveryPlan[]
  weeklyPreparationReviews     WeeklyPreparationReview[]
  monthlyPreparationReviews    MonthlyPreparationReview[]
  studyStreakRecord            StudyStreak?

  // Phase 12: Final-Mile Exam Readiness & Full Exam Simulation OS
  finalMileConfig              FinalMileConfiguration?
  finalRevisionPlans           FinalRevisionPlan[]
  examSimulationAttempts       ExamSimulationAttempt[]
  examSimulationResults        ExamSimulationResult[]
  simulationReviewItems        SimulationReviewQueue[]
  finalMileActionPlans         FinalMileActionPlan[]
  finalDaysMode                FinalDaysMode?
  examDayChecklistItems        ExamDayChecklist[]
  examReadinessSnapshots       ExamReadinessSnapshot[]
  simulationComparisons        SimulationComparison[]

  // Phase 14: Content Review & Scientific Validation
  contentReviewsAssigned       ContentReview[]

  // Phase 15: Student Learning Intelligence & Personalization
  learningProfile              StudentLearningProfile?
  learningSnapshots            StudentLearningSnapshot[]
  learningBaselines            StudentBaseline[]
  learningTrends               LearningTrend[]
  learningInterventions        LearningIntervention[]
  learningInsights             LearningInsight[]

  // Phase 16: Complete NCERT Learning System
  topicProgresses              TopicProgress[]
}

model StudentProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetExamYear       Int      @default(2027)
  dailyTargetQuestions Int      @default(50)
  dailyTargetMinutes   Int      @default(180)
  currentStreak        Int      @default(0)
  totalAttempted       Int      @default(0)
  totalCorrect         Int      @default(0)
  accuracyRate         Float    @default(0.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ClassLevel {
  id        String    @id @default(cuid())
  name      String    // "Class 11", "Class 12"
  code      String    @unique // "CLASS_11", "CLASS_12"
  order     Int       @default(1)
  subjects  Subject[]
  questions Question[]
}

model Subject {
  id           String      @id @default(cuid())
  name         String      // "Physics", "Chemistry", "Biology"
  code         String      // "PHYSICS", "CHEMISTRY", "BIOLOGY"
  classLevelId String
  classLevel   ClassLevel  @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  units        Unit[]
  chapters     Chapter[]
  questions    Question[]

  @@unique([code, classLevelId])
}

model Unit {
  id          String    @id @default(cuid())
  title       String
  unitNumber  Int
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
}

model Chapter {
  id              String      @id @default(cuid())
  chapterNumber   Int
  title           String
  slug            String      @unique
  subjectId       String
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            Unit?       @relation(fields: [unitId], references: [id])
  biologyCategory String?     // "BOTANY" | "ZOOLOGY" | null
  ncertBookCode   String?     // e.g. "kebo101", "keph101"
  topics          Topic[]
  concepts        Concept[]
  questions       Question[]
  sections        ContentSection[]
  figures         ContentFigure[]
  tables          ContentTable[]
  studyProgress   StudyProgress[]
  mistakes        StudentMistake[]
}

model Topic {
  id                    String          @id @default(cuid())
  topicNumber           String?         // "2.1", "2.2", etc.
  title                 String
  orderIndex            Int             @default(1)
  slug                  String?         @unique
  chapterId             String
  chapter               Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  pageStart             Int?
  pageEnd               Int?
  contentHtml           String?
  contentMarkdown       String?
  sourceProvenance      String?         // JSON metadata
  hinglishExplanation  String?
  englishExplanation   String?
  hindiExplanation     String?
  audioScriptHinglish   String?
  audioScriptEnglish    String?
  audioScriptHindi      String?
  audioUrl              String?
  subtopics             Subtopic[]
  concepts              Concept[]
  questions             Question[]
  topicProgresses       TopicProgress[]
}

model Subtopic {
  id             String     @id @default(cuid())
  subtopicNumber String?    // "2.1.1", "2.1.2", etc.
  title          String
  orderIndex     Int        @default(1)
  topicId        String
  topic          Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contentHtml    String?
  concepts       Concept[]
  questions      Question[]
}

model TopicProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId         String
  topic           Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status          String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  contentRead     Boolean   @default(false)
  explanationUsed Boolean   @default(false)
  audioListened   Boolean   @default(false)
  dppCompleted         Boolean   @default(false)
  dppScore             Float?
  mtgPracticeCompleted Boolean   @default(false)
  mtgPracticeScore     Float?
  completedAt          DateTime?
  lastAccessedAt  DateTime  @default(now())

  @@unique([userId, topicId])
}

model Concept {
  id                       String             @id // Stable ID e.g. "CONCEPT_NEWTON_2ND_LAW"
  name                     String
  description              String?
  formula                  String?
  definition               String?
  laws                     String?
  importantStatements      String?
  scientificNames          String?
  chemicalReactions        String?
  mathematicalRelationships String?
  exceptions               String?
  ncertReference           String?            // JSON: { chapter, pageStart, pageEnd, sectionNumber }
  chapterId                String
  chapter                  Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topicId                  String?
  topic                    Topic?             @relation(fields: [topicId], references: [id])
  subtopicId               String?
  subtopic                 Subtopic?          @relation(fields: [subtopicId], references: [id])
  primaryQuestions         Question[]         @relation("PrimaryConcept")
  mistakes                 StudentMistake[]
  revisions                RevisionSchedule[]
  masteries                StudentConceptMastery[]
}

model ContentAsset {
  id               String           @id @default(cuid())
  title            String
  filename         String
  originalPath     String?
  storageKey       String?
  assetType        String           // "NCERT_BOOK" | "FINGERTIPS" | "PYQ_PAPER"
  fileSize         Int
  mimeType         String           @default("application/pdf")
  checksum         String?
  processingStatus String           @default("PENDING") // PENDING | PROCESSING | EXTRACTED | FAILED
  totalPages       Int              @default(0)
  pagesProcessed   Int              @default(0)
  metadata         String?          // JSON metadata
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  versions         ContentVersion[]
  questions        Question[]
  pageLogs         PageProcessingLog[]
  figures          ContentFigure[]
  tables           ContentTable[]
}

model ContentSection {
  id            String   @id @default(cuid())
  chapterId     String
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sectionNumber String?
  title         String
  pageStart     Int
  pageEnd       Int?
  contentHtml   String?
  createdAt     DateTime @default(now())
}

model ContentFigure {
  id             String       @id @default(cuid())
  contentAssetId String
  contentAsset   ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  chapterId      String?
  chapter        Chapter?     @relation(fields: [chapterId], references: [id])
  figureNumber   String?      // e.g. "Figure 2.6"
  caption        String
  imagePath      String       // relative URL e.g. "/extracted_figures/fig_kebo102_p11_1.png"
  labels         String?      // JSON array of callouts e.g. ["RNA", "Capsid"]
  pageNumber     Int
  createdAt      DateTime     @default(now())
}

model ContentTable {
  id             String       @id @default(cuid())
  contentAssetId String
  contentAsset   ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  chapterId      String?
  chapter        Chapter?     @relation(fields: [chapterId], references: [id])
  tableNumber    String?      // e.g. "Table 2.1"
  title          String
  headersJson    String       // JSON array of column headers
  rowsJson       String       // JSON 2D array of row cells
  pageNumber     Int
  createdAt      DateTime     @default(now())
}

model PageProcessingLog {
  id                 String       @id @default(cuid())
  contentAssetId     String
  contentAsset       ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  pageNumber         Int
  status             String       @default("PENDING") // PENDING | IN_PROGRESS | DONE | FAILED
  retryCount         Int          @default(0)
  conceptsExtracted  Int          @default(0)
  questionsExtracted Int          @default(0)
  errorMessage       String?
  updatedAt          DateTime     @default(now())

  @@unique([contentAssetId, pageNumber])
}

model ContentVersion {
  id              String        @id @default(cuid())
  contentAssetId  String?
  contentAsset    ContentAsset? @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  contentId       String?       // Generic content object identifier (Question, Concept, Section, etc.)
  contentType     String?       // NCERT | PYQ | FINGERTIPS | QUESTION | CONCEPT | TOPIC | CHAPTER | FIGURE | TABLE | EXPLANATION | SOLUTION | REVISION_NOTE | AI_GENERATED_CONTENT | AI_GENERATED_QUESTION
  versionNumber   Int           @default(1)
  contentSnapshot String?       // Serialized text or JSON content
  sourceSnapshot  String?       // Provenance metadata snapshot
  contentHash     String?       // SHA-256 hash
  changeType      String?       // CREATED | MODIFIED | REVISED | RETIRED | RESTORED
  changeReason    String?
  changedBy       String?
  changeLog       String?
  createdAt       DateTime      @default(now())

  @@index([contentId])
  @@index([contentType])
  @@index([contentHash])
}

model Question {
  id                     String            @id // Stable unique ID e.g. "Q_AIIMS_2006_PHY_001"
  questionText           String
  questionType           String            @default("SINGLE_CORRECT") // SINGLE_CORRECT | ASSERTION_REASON | STATEMENT_BASED | MATCH_THE_FOLLOWING | NUMERICAL | DIAGRAM_BASED | PASSAGE_BASED
  difficulty             String            @default("MEDIUM")         // EASY | MEDIUM | HARD
  subjectId              String
  subject                Subject           @relation(fields: [subjectId], references: [id])
  classLevelId           String
  classLevel             ClassLevel        @relation(fields: [classLevelId], references: [id])
  chapterId              String
  chapter                Chapter           @relation(fields: [chapterId], references: [id])
  topicId                String?
  topic                  Topic?            @relation(fields: [topicId], references: [id])
  subtopicId             String?
  subtopic               Subtopic?         @relation(fields: [subtopicId], references: [id])
  primaryConceptId       String?
  primaryConcept         Concept?          @relation("PrimaryConcept", fields: [primaryConceptId], references: [id])
  secondaryConceptIds    String?           // JSON array string: ["CONCEPT_A", "CONCEPT_B"]
  sourceType             String            @default("PYQ")            // PYQ | FINGERTIPS | NCERT_EXEMPLAR | AI_GENERATED
  examName               String?           // "NEET-UG", "AIIMS", "AIPMT"
  examYear               Int?              // Strictly verified year
  examShift              String?           // "Shift 1", etc.
  originalQuestionNumber String?
  sourceDocumentId       String?
  sourceDocument         ContentAsset?     @relation(fields: [sourceDocumentId], references: [id])
  sourcePage             Int?
  extractionMethod       String            @default("EMBEDDED_TEXT")  // EMBEDDED_TEXT | OCR | HYBRID
  ocrConfidence          Float             @default(1.0)
  qualityScore           Float             @default(1.0)              // Internal quality score 0.0 - 1.0
  qualityFlags           String?           // JSON array string
  verificationStatus     String            @default("NEEDS_REVIEW")   // DRAFT | PROCESSING | NEEDS_REVIEW | VERIFIED | REJECTED | DUPLICATE_CANDIDATE
  publicationStatus      String            @default("UNPUBLISHED")    // UNPUBLISHED | PUBLISHED | ARCHIVED
  mappingStatus          String            @default("AUTO_MAPPED")    // AUTO_MAPPED | REVIEW_REQUIRED | MANUALLY_MAPPED
  lastVerifiedAt         DateTime?
  verifiedBy             String?
  correctOption          String            // "A", "B", "C", "D"
  explanation            String?
  whyThisQuestion        String?           // JSON: { conceptTested, ncertRef, pyqFrequency, patternNotes }
  fingerprint            String?           // SHA256 deduplication fingerprint
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  bookName               String?           // For Fingertips: e.g. "MTG Objective NCERT at your Fingertips - Biology"
  bookEdition            String?           // e.g. "2026", "Latest Rationalised"
  yearConfidence         Float             @default(1.0)
  yearSource             String            @default("EXPLICIT_HEADER") // EXPLICIT_HEADER | EXPLICIT_METADATA | SOURCE_FILENAME | INFERRED | UNKNOWN
  difficultySource       String            @default("SOURCE")         // SOURCE | DERIVED | MANUAL
  difficultyConfidence   Float             @default(1.0)
  answerValidationStatus String            @default("VERIFIED")       // VERIFIED | CONFLICT | NEEDS_REVIEW
  linkConfidence         String            @default("HIGH")           // HIGH | MEDIUM | LOW
  linkMethod             String            @default("EXACT_TERM")     // EXACT_TERM | KEYWORD | SEMANTIC | AI | MANUAL
  duplicateOfId          String?
  sameQuestionAsId       String?           // Cross-source reference (e.g. Fingertips question based on PYQ)

  syllabusStatus         String            @default("CURRENT") // CURRENT | OUTSIDE_CURRENT_SYLLABUS | UNMAPPED | REVIEW_REQUIRED

  // Phase 10: Assessment Intelligence & Psychometrics
  assessmentStatus       String            @default("ACTIVE") // ACTIVE | MONITORED | REVIEW_REQUIRED | TEMPORARILY_SUPPRESSED | RETIRED

  options                QuestionOption[]
  figures                QuestionFigure[]
  testQuestions          TestQuestion[]
  studentResponses       StudentResponse[]
  mistakes               StudentMistake[]
  bookmarks              StudentBookmark[]
  revisions              RevisionSchedule[]
  attemptEvents          AttemptEvent[]
  exposures              QuestionExposure[]

  // Phase 10 Relations
  assessmentProfile      QuestionAssessmentProfile?
  performanceSnapshots   QuestionPerformanceSnapshot[]
  optionPerformances     QuestionOptionPerformance[]
  anomalies              QuestionAnomaly[]
  versions               QuestionVersion[]
  reviews                QuestionReview[]
  aiValidations          AIQuestionValidation[]
  formQuestions          TestFormQuestion[]

  // Phase 12 Relations
  simulationSnapshots    SimulationQuestionSnapshot[]
  simulationReviews      SimulationReviewQueue[]

  @@index([fingerprint])
  @@index([verificationStatus, publicationStatus])
  @@index([subjectId, chapterId])
  @@index([examYear, examName])
  @@index([sourceType])
  @@index([syllabusStatus])
  @@index([assessmentStatus])
}

model QuestionFigure {
  id               String       @id @default(cuid())
  questionId       String
  question         Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assetPath        String       // relative URL e.g. "/extracted_figures/q_fig_xxx.png"
  caption          String?
  sourcePage       Int?
  boundingBox      String?      // JSON [x0, y0, x1, y1]
  extractionMethod String       @default("VECTOR_IMAGE") // VECTOR_IMAGE | RASTER_CROP
  createdAt        DateTime     @default(now())

  @@index([questionId])
}

model QuestionIdentity {
  id                  String    @id @default(cuid())
  normalizedHash      String    @unique
  semanticHash        String?
  canonicalQuestionId String?
  questionIds         String    // JSON array string of question IDs sharing this identity
  sourceCount         Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([normalizedHash])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String   // "A", "B", "C", "D"
  text       String
  orderIndex Int      @default(1)

  @@unique([questionId, label])
}

model ExamPattern {
  id                   String          @id @default(cuid())
  examName             String          @default("NEET UG")
  examYear             Int             @default(2027)
  durationMinutes      Int             @default(180)
  totalQuestions       Int             @default(180)
  totalMarks           Float           @default(720.0)
  positiveMarks        Float           @default(4.0)
  negativeMarks        Float           @default(1.0)
  subjectConfiguration String          // JSON: { BIOLOGY: 90, PHYSICS: 45, CHEMISTRY: 45 }
  sectionConfiguration String?         // JSON: { SectionA: { count: 35, compulsory: true }, SectionB: { count: 15, maxToAttempt: 10 } }
  instructions         String?         // Full exam instructions markdown
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  tests                Test[]
  blueprints           TestBlueprint[]

  @@index([active])
}

model TestBlueprint {
  id                     String        @id @default(cuid())
  title                  String
  examPatternId          String?
  examPattern            ExamPattern?  @relation(fields: [examPatternId], references: [id])
  targetCount            Int           @default(180)
  subjectDistribution    String        // JSON: { BIOLOGY: 90, PHYSICS: 45, CHEMISTRY: 45 }
  domainDistribution     String?       // JSON: { BOTANY: 45, ZOOLOGY: 45, MECHANICS: 15, ... }
  difficultyDistribution String?       // JSON: { EASY: 0.35, MEDIUM: 0.50, HARD: 0.15 }
  sourceDistribution     String?       // JSON: { PYQ: 0.40, NCERT: 0.40, FINGERTIPS: 0.20 }
  rulesJson              String?       // JSON: { allowDuplicates: false, requireVerified: true, minQualityScore: 0.70 }
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  tests                  Test[]
}

model Test {
  id               String          @id @default(cuid())
  title            String
  description      String?
  testType         String          @default("CUSTOM") // FULL_MOCK | GRAND_MOCK | SUBJECT_TEST | CHAPTER_TEST | TOPIC_TEST | PYQ_TEST | WEAKNESS_TEST | REVISION_TEST | CUSTOM_TEST | PRACTICE
  durationMinutes  Int             @default(60)
  totalMarks       Int             @default(180)
  totalQuestions   Int             @default(45)
  positiveMarks    Float           @default(4.0)
  negativeMarks    Float           @default(1.0)
  isConfigurable   Boolean         @default(true)
  isPublished      Boolean         @default(true)
  templateType     String          @default("NEET_FULL")
  configJson       String?         // Configurable duration, marking, subject distribution
  version          Int             @default(1)
  examPatternId    String?
  examPattern      ExamPattern?    @relation(fields: [examPatternId], references: [id])
  blueprintId      String?
  blueprint        TestBlueprint?  @relation(fields: [blueprintId], references: [id])
  blueprintJson    String?         // Immutable snapshot of blueprint used for this test
  mode             String          @default("EXAM") // PRACTICE | TEST | EXAM | REVIEW
  publishedAt      DateTime?
  createdBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  testQuestions    TestQuestion[]
  attempts         ExamAttempt[]

  // Phase 8: Multi-Tenant Custom Tests
  tenantId         String?
  tenant           Tenant?         @relation("TenantTests", fields: [tenantId], references: [id])
  isCustom         Boolean         @default(false)
  simulations      ExamSimulation[]

  @@index([testType])
  @@index([isPublished])
  @@index([version])
  @@index([tenantId])
}

model TestQuestion {
  id            String   @id @default(cuid())
  testId        String
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sectionName   String   @default("Section A")
  questionOrder Int      @default(1)
  marks         Float?
  negativeMarks Float?
  subject       String?

  @@unique([testId, questionId])
  @@unique([testId, questionOrder])
  @@index([testId])
  @@index([questionId])
}

model ExamAttempt {
  id                  String            @id @default(cuid())
  testId              String
  test                Test              @relation(fields: [testId], references: [id])
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt           DateTime          @default(now())
  submittedAt         DateTime?
  expiresAt           DateTime?         // Server authoritative expiry: startedAt + allowedDuration
  durationSeconds     Int               @default(0)
  totalScore          Float             @default(0.0)
  accuracy            Float             @default(0.0)
  status              String            @default("CREATED") // CREATED | IN_PROGRESS | PAUSED | EXPIRED | SUBMITTED | EVALUATED | CANCELLED
  activeQuestionIndex Int               @default(0)
  remainingSeconds    Int               @default(0)
  isSubmitted         Boolean           @default(false)
  submissionToken     String?           @unique // Idempotency token
  version             Int               @default(1) // Version of test attempted
  mode                String            @default("EXAM") // PRACTICE | TEST | EXAM | REVIEW
  section             String?           // Active section name
  lastHeartbeatAt     DateTime?
  markedForReviewJson String?           // JSON array of question IDs
  answersJson         String?           // JSON map of { questionId: selectedOption }
  templateType        String            @default("NEET_FULL")
  analyticsJson       String?           // Comprehensive post-test analysis
  timeAnalysisJson    String?           // Detailed question and section timing analytics
  actionPlanJson      String?           // Post-mock action plan
  metadataJson        String?           // Client/Browser/Network metadata
  snapshotData        String?           // Immutable snapshot of question and answers at attempt time
  responses           StudentResponse[]

  // Phase 12: Simulation link
  simulationAttempt   ExamSimulationAttempt?

  @@index([userId])
  @@index([testId])
  @@index([status])
  @@index([submissionToken])
}

model StudentResponse {
  id                 String      @id @default(cuid())
  examAttemptId      String
  examAttempt        ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  questionId         String
  question           Question    @relation(fields: [questionId], references: [id])
  selectedOption     String?     // "A", "B", "C", "D" or null
  isCorrect          Boolean     @default(false)
  isMarkedForReview  Boolean     @default(false)
  timeSpentSeconds   Int         @default(0)
  marksAwarded       Float       @default(0.0)

  // Phase 10: Immutable Question Version Snapshot
  questionVersionId      String?
  correctOptionAtAttempt String?
  responseTimeMs         Int?
  conceptSnapshot        String?
  difficultySnapshot     String?

  // Phase 12: Answer Change & Confidence Tracking
  originalAnswer         String?
  finalAnswer            String?
  isAnswerChanged        Boolean     @default(false)
  confidenceLevel        String?     // HIGH_CONFIDENCE | MEDIUM_CONFIDENCE | LOW_CONFIDENCE

  @@unique([examAttemptId, questionId])
}

model StudentMistake {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  conceptId      String?
  concept        Concept?  @relation(fields: [conceptId], references: [id])
  chapterId      String
  chapter        Chapter   @relation(fields: [chapterId], references: [id])
  selectedOption String?
  correctOption  String
  mistakeCount   Int       @default(1)
  lastMistakeAt  DateTime  @default(now())
  isResolved     Boolean   @default(false)
  mistakeType    String    @default("UNKNOWN") // CONCEPTUAL | CALCULATION | MEMORY | MISREAD | SILLY | TIME_PRESSURE | OPTION_CONFUSION | FORMULA | DIAGRAM_INTERPRETATION | GUESS | UNKNOWN
  confidence     Float     @default(0.5)
  evidence       String?   // JSON reasoning for mistake detection
  notes          String?
  isLearned      Boolean   @default(false)
  learnedAt      DateTime?

  @@unique([userId, questionId])
}

model StudentBookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model StudyProgress {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId          String
  chapter            Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  conceptsCompleted  Int       @default(0)
  questionsAttempted Int       @default(0)
  accuracy           Float     @default(0.0)
  lastStudiedAt      DateTime  @default(now())

  @@unique([userId, chapterId])
}

model RevisionSchedule {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId       String?
  concept         Concept?  @relation(fields: [conceptId], references: [id])
  questionId      String?
  question        Question? @relation(fields: [questionId], references: [id])
  category        String    @default("DUE_TODAY") // DUE_TODAY | DUE_SOON | WEAK | MASTERED
  repetitionLevel Int       @default(0)
  intervalDays    Int       @default(1)
  easeFactor      Float     @default(2.5)
  lastReviewedAt  DateTime?
  nextRevisionAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. "APPROVE_QUESTION", "EDIT_QUESTION", "PUBLISH_CONTENT"
  entityType String   // "Question", "Chapter", "ContentAsset"
  entityId   String
  oldValues  String?  // JSON snapshot
  newValues  String?  // JSON snapshot
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model StudentConceptMastery {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId            String
  concept              Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  masteryScore         Float     @default(0.0) // 0.0 to 100.0
  confidenceScore      Float     @default(0.0) // 0.0 to 1.0
  accuracy             Float     @default(0.0) // 0.0 to 100.0
  attempts             Int       @default(0)
  correctAttempts      Int       @default(0)
  incorrectAttempts    Int       @default(0)
  lastAttemptAt        DateTime?
  lastCorrectAt        DateTime?
  lastIncorrectAt      DateTime?
  averageTime          Float     @default(0.0) // in seconds
  expectedTime         Float     @default(60.0) // in seconds
  consecutiveCorrect   Int       @default(0)
  consecutiveIncorrect Int       @default(0)
  revisionCount        Int       @default(0)
  nextReviewAt         DateTime?
  status               String    @default("UNSEEN") // UNSEEN | LEARNING | WEAK | REVIEW_DUE | MASTERED
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, conceptId])
  @@index([userId])
  @@index([conceptId])
  @@index([nextReviewAt])
  @@index([status])
}

model AttemptEvent {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   String?
  correctOption    String
  isCorrect        Boolean
  timeSpentSeconds Int       @default(0)
  startedAt        DateTime  @default(now())
  answeredAt       DateTime  @default(now())
  sourceType       String    // PYQ | FINGERTIPS | NCERT | NCERT_EXERCISE
  examYear         Int?
  chapterId        String?
  topicId          String?
  conceptId        String?
  difficulty       String    @default("MEDIUM")
  mistakeType      String?   // CONCEPTUAL | CALCULATION | MEMORY | MISREAD | SILLY | TIME_PRESSURE | OPTION_CONFUSION | FORMULA | DIAGRAM_INTERPRETATION | GUESS | UNKNOWN
  confidence       Float     @default(1.0)
  evidenceJson     String?   // JSON reasoning for mistake detection
  sessionId        String?
  sourceContext    String?   // PRACTICE | CBT | REMEDIATION | RETRY_MISTAKE

  @@index([userId])
  @@index([questionId])
  @@index([conceptId])
  @@index([chapterId])
  @@index([answeredAt])
}

model QuestionExposure {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  state            String    @default("SEEN") // UNSEEN | SEEN | ANSWERED_CORRECT | ANSWERED_WRONG | MASTERED | REVIEW_DUE | OVEREXPOSED | PRACTICED | NEW
  timesAttempted   Int       @default(1)
  correctCount     Int       @default(0)
  incorrectCount   Int       @default(0)
  firstSeenAt      DateTime  @default(now())
  lastAttemptedAt  DateTime  @default(now())
  lastMode         String?   // PRACTICE | CBT | MOCK | REMEDIATION | TUTOR
  nextReviewAt     DateTime?

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@index([state])
}

model DailyLearningPlan {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDate     String    // YYYY-MM-DD
  missionsJson String    // JSON formatted tasks
  status       String    @default("ACTIVE") // ACTIVE | COMPLETED
  generatedAt  DateTime  @default(now())

  @@unique([userId, planDate])
  @@index([userId])
}

model PerformanceSnapshot {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodType              String    // DAILY | WEEKLY | POST_MOCK
  snapshotDate            DateTime  @default(now())
  overallMastery          Float     @default(0.0)
  practiceAccuracy        Float     @default(0.0)
  totalQuestionsSolved    Int       @default(0)
  pyqCoverageRate         Float     @default(0.0)
  revisionCompletion      Float     @default(0.0)
  mockTestAverageScore    Float     @default(0.0)
  mockTestAverageAccuracy Float     @default(0.0)
  weakConceptsCount       Int       @default(0)
  timeEfficiencySeconds   Float     @default(0.0)
  consistencyStreakDays   Int       @default(0)
  metricsJson             String?   // JSON breakdown of 8 readiness dimensions

  @@index([userId])
  @@index([snapshotDate])
  @@index([periodType])
}

model TutorConversation {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String         @default("New Tutoring Session")
  activeMode   String         @default("ASK_DOUBT") // ASK_DOUBT | EXPLAIN_CONCEPT | SOLVE_QUESTION | TEACH_ME | REVISION | MISTAKE_ANALYSIS | PYQ_COACH | EXAM_STRATEGY | QUIZ_ME | WEAKNESS_COACH
  subject      String?        // BIO | PHY | CHE
  chapterId    String?
  conceptId    String?
  questionId   String?
  metadataJson String?        // Context metadata
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     TutorMessage[]

  @@index([userId])
  @@index([activeMode])
  @@index([createdAt])
}

model TutorMessage {
  id              String            @id @default(cuid())
  conversationId  String
  conversation    TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String            // USER | ASSISTANT | SYSTEM
  content         String
  mode            String            // Active tutor mode
  responseType    String            @default("EXPLANATION") // EXPLANATION | SOLUTION | REVISION | QUIZ | FEEDBACK | REMEDIATION | STRATEGY | GENERAL
  groundingStatus String            @default("GROUNDED") // GROUNDED | PARTIALLY_GROUNDED | NOT_GROUNDED
  sourcesJson     String?           // Array of verified source references
  actionsJson     String?           // Array of interactive learning actions
  questionId      String?           // Referenced question if any
  conceptId       String?           // Referenced concept if any
  tokensUsed      Int               @default(0)
  latencyMs       Int               @default(0)
  provider        String            @default("SYSTEM_ENGINE")
  modelName       String            @default("grounded-v1")
  createdAt       DateTime          @default(now())
  feedback        AIFeedback[]

  @@index([conversationId])
  @@index([role])
  @@index([responseType])
  @@index([createdAt])
}

model AIFeedback {
  id        String       @id @default(cuid())
  messageId String
  message   TutorMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHelpful Boolean
  rating    Int?         // 1-5
  reason    String?      // INCORRECT | POOR_EXPLANATION | WRONG_SOURCE | UNCLEAR | OTHER
  comments  String?
  createdAt DateTime     @default(now())

  @@index([messageId])
  @@index([userId])
  @@index([isHelpful])
}

model AIUsageLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String   // LOCAL | GOOGLE | OPENAI | ANTHROPIC
  model            String
  endpoint         String   // chat | explain | solve | quiz | etc.
  mode             String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCost    Float    @default(0.0)
  latencyMs        Int      @default(0)
  status           String   @default("SUCCESS") // SUCCESS | ERROR | FALLBACK | RATE_LIMITED
  groundingStatus  String   @default("GROUNDED")
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([provider])
  @@index([endpoint])
  @@index([createdAt])
}

model AIRateLimit {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyMessageCap Int      @default(100)
  dailyImageCap   Int      @default(20)
  messagesUsed    Int      @default(0)
  imagesUsed      Int      @default(0)
  lastResetDate   String   // YYYY-MM-DD
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ==============================================================================
// PHASE 7: PARENT + MENTOR + ADMIN COMMAND CENTER MODELS
// ==============================================================================

model ParentStudentRelationship {
  id               String    @id @default(cuid())
  parentId         String
  parent           User      @relation("ParentRelationship", fields: [parentId], references: [id], onDelete: Cascade)
  studentId        String
  student          User      @relation("StudentParentRelationship", fields: [studentId], references: [id], onDelete: Cascade)
  status           String    @default("PENDING") // PENDING | ACTIVE | REVOKED | REJECTED
  relationshipType String    @default("PARENT")  // FATHER | MOTHER | GUARDIAN | PARENT
  requestedAt      DateTime  @default(now())
  approvedAt       DateTime?
  approvedBy       String?   // userId of student or admin who approved
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@index([status])
}

model MentorStudentAssignment {
  id         String    @id @default(cuid())
  mentorId   String
  mentor     User      @relation("MentorAssignments", fields: [mentorId], references: [id], onDelete: Cascade)
  studentId  String
  student    User      @relation("StudentMentorAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy String    // userId of admin or authorized mentor
  assignedAt DateTime  @default(now())
  status     String    @default("ACTIVE") // ACTIVE | PAUSED | REVOKED
  revokedAt  DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([mentorId, studentId])
  @@index([mentorId])
  @@index([studentId])
  @@index([status])
}

model Assignment {
  id           String               @id @default(cuid())
  creatorId    String
  creator      User                 @relation("AssignmentCreator", fields: [creatorId], references: [id])
  title        String
  description  String?
  type         String               // NCERT_READING | PRACTICE | PYQ | FINGERTIPS | REVISION | TEST | MOCK | AI_TUTOR_SESSION | CUSTOM
  subject      String?              // BIOLOGY | PHYSICS | CHEMISTRY
  chapterId    String?
  conceptId    String?
  testId       String?
  targetCount  Int                  @default(0) // e.g. 20 questions
  dueDate      DateTime?
  configJson   String?              // Task specific constraints
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  progressList AssignmentProgress[]

  // Phase 8: Multi-Tenant Assignment Scoping
  tenantId     String?
  tenant       Tenant?              @relation("TenantAssignments", fields: [tenantId], references: [id])

  @@index([creatorId])
  @@index([type])
  @@index([dueDate])
  @@index([tenantId])
}

model AssignmentProgress {
  id              String     @id @default(cuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId       String
  student         User       @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  status          String     @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | OVERDUE
  currentProgress Int        @default(0) // actual questions solved or concepts read
  targetProgress  Int        @default(100)
  score           Float?
  startedAt       DateTime?
  completedAt     DateTime?
  lastActivityAt  DateTime?
  evidenceJson    String?    // Verified activity proof (attemptIds, sessionIds)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model MentorNote {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation("StudentNotes", fields: [studentId], references: [id], onDelete: Cascade)
  title      String?
  content    String
  visibility String   @default("MENTOR_ONLY") // MENTOR_ONLY | ADMIN_ONLY | STUDENT_VISIBLE | PARENT_VISIBLE
  category   String   @default("GENERAL")     // GENERAL | STRENGTH | WEAKNESS | ACTION_PLAN | BEHAVIORAL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([authorId])
  @@index([studentId])
  @@index([visibility])
}

model Notification {
  id              String    @id @default(cuid())
  recipientId     String
  recipient       User      @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type            String    // ASSIGNMENT | REVISION | TEST | FEEDBACK | SYSTEM | REMINDER
  title           String
  message         String
  relatedEntity   String?   // e.g. "Assignment:cmu...", "Test:..."
  isParentVisible Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([recipientId])
  @@index([type])
  @@index([readAt])
}

model Goal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserGoals", fields: [userId], references: [id], onDelete: Cascade)
  title      String
  metricType String   // QUESTIONS_COUNT | ACCURACY_RATE | TESTS_COMPLETED | REVISION_RATE | STUDY_MINUTES
  target     Float
  current    Float    @default(0.0)
  period     String   // DAILY | WEEKLY | MONTHLY
  status     String   @default("ACTIVE") // ACTIVE | COMPLETED | MISSED | PAUSED
  startDate  DateTime @default(now())
  endDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model LearningActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
  activityType    String   // PRACTICE | CBT | REVISION | AI_TUTOR | ASSIGNMENT | NCERT_READING
  durationSeconds Int      @default(0)
  relatedEntity   String?  // questionId, testId, conceptId, assignmentId
  metadataJson    String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
}

model Alert {
  id                    String    @id @default(cuid())
  studentId             String
  student               User      @relation("UserAlerts", fields: [studentId], references: [id], onDelete: Cascade)
  type                  String    // REVISION_OVERDUE | ASSIGNMENT_OVERDUE | NO_RECENT_ACTIVITY | REPEATED_MISTAKE | LOW_ACCURACY | TEST_PERFORMANCE_DROP
  severity              String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  title                 String
  description           String
  evidenceJson          String?   // Quantitative data & factual metrics
  suggestedIntervention String?   // Actionable pedagogical recommendation
  isResolved            Boolean   @default(false)
  resolvedAt            DateTime?
  resolvedBy            String?
  createdAt             DateTime  @default(now())

  @@index([studentId])
  @@index([type])
  @@index([isResolved])
}

model Invitation {
  id         String    @id @default(cuid())
  inviterId  String
  inviter    User      @relation("InvitationCreator", fields: [inviterId], references: [id])
  email      String
  role       String    // PARENT | MENTOR
  studentId  String?   // Linked student target
  token      String    @unique
  expiresAt  DateTime
  isUsed     Boolean   @default(false)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([isUsed])
}

// ============================================================================
// PHASE 8: PRODUCTION SAAS, MULTI-TENANCY, BILLING & OPERATIONS MODELS
// ============================================================================

model Tenant {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  type          String             @default("INDIVIDUAL") // INDIVIDUAL | COACHING | SCHOOL | ORGANIZATION
  status        String             @default("ACTIVE")     // ACTIVE | SUSPENDED | PENDING
  planId        String?
  plan          Plan?              @relation(fields: [planId], references: [id])
  users         User[]             @relation("TenantUsers")
  subscriptions Subscription[]
  customTests   Test[]             @relation("TenantTests")
  assignments   Assignment[]       @relation("TenantAssignments")
  usageCounters UsageCounter[]
  featureFlags  FeatureFlag[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([slug])
  @@index([type])
  @@index([status])
}

model Plan {
  id              String               @id @default(cuid())
  name            String               @unique // FREE | STUDENT | PRO | INSTITUTE
  description     String?
  price           Float                @default(0.0)
  currency        String               @default("INR")
  billingInterval String               @default("MONTHLY") // MONTHLY | YEARLY | LIFETIME
  status          String               @default("ACTIVE")  // ACTIVE | ARCHIVED
  featuresJson    String?
  limitsJson      String?
  tenants         Tenant[]
  subscriptions   Subscription[]
  entitlements    FeatureEntitlement[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
}

model Subscription {
  id                     String    @id @default(cuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan      @relation(fields: [planId], references: [id])
  status                 String    @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | PAUSED | CANCELLED | EXPIRED
  startedAt              DateTime  @default(now())
  expiresAt              DateTime?
  cancelledAt            DateTime?
  trialEndsAt            DateTime?
  provider               String    @default("SANDBOX") // STRIPE | RAZORPAY | SANDBOX
  providerSubscriptionId String?
  providerCustomerId     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

model FeatureEntitlement {
  id         String   @id @default(cuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature    String   // PRACTICE | PYQ | FINGERTIPS | CBT | FULL_MOCK | AI_TUTOR | AI_IMAGE_SOLVER | ADVANCED_ANALYTICS | PARENT_DASHBOARD | MENTOR_DASHBOARD | EXPORT | CUSTOM_TESTS
  isEnabled  Boolean  @default(true)
  limitValue Int?     // null = unlimited, otherwise max numeric limit
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([planId, feature])
  @@index([planId])
  @@index([feature])
}

model UsageCounter {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  feature   String    // AI_MESSAGES | AI_IMAGE_QUESTIONS | MOCK_TESTS | QUESTIONS_DAILY | EXPORTS_MONTHLY
  period    String    // DAILY | MONTHLY | TOTAL
  periodKey String    // e.g. "2026-09-30" or "2026-09"
  count     Int       @default(0)
  resetAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, feature, periodKey])
  @@index([tenantId])
  @@index([feature])
}

model Coupon {
  id                 String   @id @default(cuid())
  code               String   @unique
  discountType       String   // PERCENTAGE | FLAT
  discountValue      Float
  maxRedemptions     Int      @default(100)
  currentRedemptions Int      @default(0)
  validFrom          DateTime @default(now())
  validUntil         DateTime
  applicablePlans    String?  // comma separated plan names or JSON
  status             String   @default("ACTIVE") // ACTIVE | EXPIRED | DISABLED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([code])
  @@index([status])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   // AI_TUTOR_V2 | NEW_CBT | ADVANCED_ANALYTICS | VOICE_TUTOR
  description String?
  isEnabled   Boolean  @default(false)
  scope       String   @default("GLOBAL") // GLOBAL | TENANT | USER
  targetId    String?  // tenantId or userId if scoped
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([scope])
}

model BackgroundJob {
  id             String    @id @default(cuid())
  queue          String    @default("default")
  type           String    // INGESTION | REPORT_GEN | NOTIFICATION | AI_PROCESS | EXPORT | CLEANUP
  payloadJson    String
  status         String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | DEAD_LETTER
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  errorDetails   String?
  idempotencyKey String?   @unique
  processedAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([queue, status])
  @@index([status])
}

model AbuseEvent {
  id        String   @id @default(cuid())
  type      String   // BRUTE_FORCE | RAPID_REQUESTS | AI_SPAM | CBT_SUBMIT_SPAM | UPLOAD_ABUSE | SCRAPING | ENUMERATION | IDOR_ATTEMPT
  userId    String?
  tenantId  String?
  ip        String?
