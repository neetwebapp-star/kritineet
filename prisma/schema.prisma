  provenanceJson  String?  // Source document, drive ID, page, section, file hash
  contentHash     String?
  isPublished     Boolean  @default(false)
  isEligibleForAI Boolean  @default(false)
  licenseStatus   String   @default("LICENSE_ALLOWED") // PRIVATE_SOURCE | LICENSE_ALLOWED | LICENSE_RESTRICTED | LICENSE_UNKNOWN
  reviewStatus    String   @default("NOT_REVIEWED") // NOT_REVIEWED | IN_REVIEW | APPROVED | REJECTED | DISPUTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contentType, status])
  @@index([sourceType])
  @@index([isPublished])
  @@index([isEligibleForAI])
}

model ContentDiff {
  id                String   @id @default(cuid())
  contentId         String
  contentType       String
  oldVersion        Int
  newVersion        Int
  changeType        String   // UNCHANGED | TEXT_CHANGED | FIGURE_CHANGED | TABLE_CHANGED | PAGE_CHANGED | STRUCTURE_CHANGED | METADATA_CHANGED | REMOVED | ADDED
  oldValue          String?
