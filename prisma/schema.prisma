  @@index([periodKey])
}

model QuestionOptionPerformance {
  id                              String    @id @default(cuid())
  questionId                      String
  question                        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionLabel                     String    // "A", "B", "C", "D"
