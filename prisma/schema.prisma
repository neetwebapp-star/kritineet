  @@index([status])
  @@index([version])
}

model MentorPlanOverride {
  id                     String          @id @default(cuid())
  planId                 String
  plan                   PreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  mentorId               String
