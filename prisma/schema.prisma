  @@index([mentorId])
  @@index([studentId])
}

model ExamUpdateNotification {
  id            String      @id @default(cuid())
  updateId      String
  update        ExamUpdate  @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  message       String
