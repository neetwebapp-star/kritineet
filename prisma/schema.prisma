model ContentLifecycle {
  id              String   @id @default(cuid())
  contentId       String   @unique
  contentType     String   // NCERT | PYQ | FINGERTIPS | QUESTION | CONCEPT | TOPIC | CHAPTER | FIGURE | TABLE | EXPLANATION | SOLUTION | REVISION_NOTE | AI_GENERATED_CONTENT | AI_GENERATED_QUESTION
  status          String   @default("DISCOVERED") // DISCOVERED | INGESTED | EXTRACTED | STRUCTURED | MAPPED | VALIDATING | REVIEW_REQUIRED | APPROVED | PUBLISHED | MONITORED | SUPERSEDED | RETIRED
  currentVersion  Int      @default(1)
