  preferredSessionLength     Int       @default(45) // in minutes
  preferredSubjects          String?   // JSON array: ["BIOLOGY", "PHYSICS", "CHEMISTRY"]
  currentPreparationStage    String    @default("FOUNDATION") // FOUNDATION | SYLLABUS_COMPLETION | FIRST_REVISION | PYQ_PHASE | MOCK_PHASE | FINAL_REVISION | EXAM_READY
  stageTransitionReason      String?
  planningMode               String    @default("BALANCED") // BALANCED | INTENSIVE | RELAXED | REVISION_HEAVY
  revisionPreference         String    @default("SPACED") // SPACED | FREQUENT | MOCK_DRIVEN
  mockFrequency              String    @default("WEEKLY") // WEEKLY | BIWEEKLY | MONTHLY
  lastPlanGeneratedAt        DateTime?
  planVersion                Int       @default(1)
  // Phase 12: Final Mile Preparation Mode
  preparationMode            String    @default("NORMAL_PREPARATION") // NORMAL_PREPARATION | FINAL_MILE | EXAM_SIMULATION | EXAM_DAY | POST_EXAM
  finalMileActivatedAt       DateTime?
  finalMileReason            String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([userId])
  @@index([currentPreparationStage])
  @@index([preparationMode])
}

model DailyStudyPlan {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  String           // YYYY-MM-DD
  targetCapacityMinutes Int              @default(180)
  plannedMinutes        Int              @default(0)
  actualMinutes         Int              @default(0)
  status                String           @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | PARTIALLY_COMPLETED | MISSED | REPLANNED
