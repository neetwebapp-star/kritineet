  eodStatus             String?          // PENDING | COMPLETED | MISSED
  eodReason             String?          // TIME | DIFFICULT_CONTENT | TECHNICAL_ISSUE | PERSONAL_SCHEDULE | LOW_PRIORITY | OTHER
