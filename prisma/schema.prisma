model OfficialSyllabusVersion {
  id             String                   @id @default(cuid())
  versionCode    String                   @unique // e.g. "NMC_UGMEB_2024_V1"
  examYear       Int                      // 2026, 2027
  authority      String                   // "NMC" | "UGMEB"
  title          String
  sourceUrl      String
  documentHash   String                   // SHA-256
  publishedAt    DateTime
  effectiveFrom  DateTime
  status         String                   @default("ACTIVE") // ACTIVE | SUPERSEDED | DRAFT
  totalUnits     Int                      @default(0)
  totalChapters  Int                      @default(0)
  totalTopics    Int                      @default(0)
  syllabusJson   String                   // Structured JSON
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  changesAsNew   OfficialSyllabusChange[] @relation("NewSyllabus")
  changesAsOld   OfficialSyllabusChange[] @relation("OldSyllabus")

  @@index([examYear])
  @@index([status])
}

model OfficialSyllabusChange {
  id               String                   @id @default(cuid())
  oldVersionId     String?
  oldVersion       OfficialSyllabusVersion? @relation("OldSyllabus", fields: [oldVersionId], references: [id])
  newVersionId     String
  newVersion       OfficialSyllabusVersion  @relation("NewSyllabus", fields: [newVersionId], references: [id])
  changeType       String                   // ADDED | REMOVED | MODIFIED | RENAMED | UNCHANGED
  subject          String                   // BIOLOGY | PHYSICS | CHEMISTRY
  chapterTitle     String
  topicTitle       String
  previousDetails  String?
  newDetails       String?
  sourceEvidence   String
  createdAt        DateTime                 @default(now())

  @@index([oldVersionId])
  @@index([newVersionId])
  @@index([changeType])
}

model NotificationImpact {
  id                     String               @id @default(cuid())
  notificationId         String
  notification           OfficialNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  impactType             String               // PLANNER_RECALCULATION | CALENDAR_DEADLINE | SYLLABUS_UPDATE | EXAM_MODE_CHANGE | ADMISSION_RULE
  affectedTopicsCount    Int                  @default(0)
  affectedChaptersCount  Int                  @default(0)
  plannerEventTitle      String?
  requiresStudentAction  Boolean              @default(false)
  actionDescription      String?
  createdAt              DateTime             @default(now())

  @@index([notificationId])
}

model NotificationAuditLog {
  id             String                @id @default(cuid())
  notificationId String?
  notification   OfficialNotification? @relation(fields: [notificationId], references: [id])
  action         String                // DETECTED | FETCHED | HASHED | CLASSIFIED | PUBLISHED | REPROCESSED | SUPERSEDED | ARCHIVED | REJECTED
  actor          String                // "WORKER_NTA_MONITOR" | "ADMIN"
  oldStatus      String?
  newStatus      String?
  detailsJson    String?
  timestamp      DateTime              @default(now())

  @@index([notificationId])
  @@index([action])
  @@index([timestamp])
}








